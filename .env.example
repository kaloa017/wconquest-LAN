# Reference only: the app does not automatically load .env files.
# Set these in your terminal, service environment or hosting dashboard.
HOST=0.0.0.0
PORT=5055
DB_PATH=game.db
# Leave blank to generate a private .session-secret beside the save.
SECRET_KEY=
# Use 1 for HTTPS-only hosting; 0 allows ordinary HTTP LAN logins.
COOKIE_SECURE=0
# Only add trusted proxy networks when configuring a local proxy/tunnel.
TRUSTED_PROXIES=
PROXY_HOPS=1
PROXY_MODE=

# Comma-separated public hostname allowlist. Blank allows LAN hostnames.
ALLOWED_HOSTS=
# Canonical public URL used in Discord/social link previews (optional for LAN).
PUBLIC_URL=
# Separate authentication protection, independent of optional game action limits.
AUTH_ATTEMPTS_PER_MINUTE=30

# Optional transactional email. Keep actual keys and forwarding inbox private.
# Sending also needs enabling in Administration > Email & verification.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Legacy Brevo support: set EMAIL_PROVIDER=brevo to use this key instead.
BREVO_API_KEY=
EMAIL_FROM=support@world-conquest.lol
EMAIL_FROM_NAME=World Conquest
EMAIL_REPLY_TO=support@world-conquest.lol
# Optional Resend receiving, requires Full access key, receiving MX and webhook.
EMAIL_INBOUND_ADDRESS=support@world-conquest.lol
EMAIL_FORWARD_TO=
RESEND_WEBHOOK_SECRET=
