# Reference only: the app does not automatically load .env files.
# Set these in your terminal, service environment or hosting dashboard.
HOST=0.0.0.0
PORT=5055
DB_PATH=game.db
# Leave blank to generate a private .session-secret beside the save.
SECRET_KEY=
# Use 1 for HTTPS-only hosting; 0 allows ordinary HTTP LAN logins.
COOKIE_SECURE=0
# Only add trusted proxy networks when configuring a local proxy/tunnel.
TRUSTED_PROXIES=
PROXY_HOPS=1
PROXY_MODE=
